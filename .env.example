# ==============================================================================
# PricePulse South Africa — Environment Configuration Template
# Copy this file to .env for local development and local scraper execution.
# NEVER commit your actual .env file or real API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare Credentials (for local Python scrapers & remote D1 execution)
# ------------------------------------------------------------------------------
# Cloudflare API Token with D1:Edit, Workers KV:Edit, and Workers AI:Read permissions
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare Account ID (Found on your Cloudflare dashboard overview)
CLOUDFLARE_ACCOUNT_ID=06f353cf7c223e6db2d2a944742a28f2

# ------------------------------------------------------------------------------
# 2. Edge Cache Administration
# ------------------------------------------------------------------------------
# Secret Bearer token required for POST /api/cache/purge and /api/cache/invalidate
ADMIN_PURGE_TOKEN=your_secure_random_purge_token_here

# ------------------------------------------------------------------------------
# 3. Local Development Server Settings
# ------------------------------------------------------------------------------
# Static frontend local port
PORT=8080

# Backend Worker local port (when running `npx wrangler dev`)
WORKER_PORT=8787

# Target D1 environment for local scraper testing: 'remote' or 'local'
SYNC_TARGET_ENV=remote
